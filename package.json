{
  "name": "filipiboats",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "start:dev": "expo start --dev-client --port 8082",
    "start:tunnel": "expo start --tunnel --port 8082",
    "android": "powershell -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "android:device": "powershell -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "setup:java": "powershell -ExecutionPolicy Bypass -File scripts/setup-java.ps1",
    "ios": "expo run:ios --port 8081",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci --coverage --coverageReporters=text-summary",
    "maestro": "powershell -ExecutionPolicy Bypass -File scripts/maestro.ps1",
    "e2e:prep": "powershell -ExecutionPolicy Bypass -File scripts/e2e-prep-android.ps1",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/maestro.ps1 -- test .maestro",
    "test:e2e:smoke": "powershell -ExecutionPolicy Bypass -File scripts/maestro.ps1 -- test .maestro/smoke.yaml",
    "test:e2e:auth": "powershell -ExecutionPolicy Bypass -File scripts/maestro.ps1 -- test .maestro/auth-flow.yaml",
    "test:e2e:notifications": "powershell -ExecutionPolicy Bypass -File scripts/maestro.ps1 -- test .maestro/notifications-flow.yaml"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.5",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "heroui-native": "^1.0.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  }
}
