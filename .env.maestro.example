# Local Maestro / E2E defaults for the Android emulator.
# Copy to .env.maestro and adjust if needed:
#   copy .env.maestro.example .env.maestro
#
# APP_ID must match app.json ios.bundleIdentifier / android.package
APP_ID=com.filipiboats.app

# Android emulator reaches the host machine at 10.0.2.2
# Docker Desktop often binds 8081 — default Metro/E2E port is 8082.
METRO_HOST=10.0.2.2
METRO_PORT=8082

# Optional: set this yourself instead of letting the script build it
# DEV_CLIENT_URL=filipiboats://expo-development-client/?url=http%3A%2F%2F10.0.2.2%3A8082%3FdisableOnboarding%3D1
